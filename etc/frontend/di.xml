<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="LokiCheckout\Core\Payment\Icon\IconResolverListing">
        <arguments>
            <argument name="iconResolvers" xsi:type="array">
                <item name="pay_nl" xsi:type="object">LokiCheckout\PayNl\Payment\Icon\IconResolver</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Payment\Redirect\RedirectResolverListing">
        <arguments>
            <argument name="redirectResolvers" xsi:type="array">
                <item name="pay_nl" xsi:type="object">LokiCheckout\PayNl\Payment\Redirect\RedirectResolver</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel">
        <plugin name="LokiCheckout_PayNl::addPaymentInstructions" type="LokiCheckout\PayNl\Plugin\AddPaymentInstructionsPlugin"/>
    </type>

    <type name="LokiCheckout\Core\Component\Checkout\Billing\PaymentMethods\PaymentMethodsRepository">
        <plugin name="LokiCheckout_PayNl::filterPaymentMethods" type="LokiCheckout\PayNl\Plugin\PaymentMethodsRepositoryPlugin" sortOrder="20"/>
    </type>

    <type name="LokiCheckout\PayNl\Plugin\PaymentMethodsRepositoryPlugin">
        <arguments>
            <argument name="checkoutState" xsi:type="object">LokiCheckout\Core\ViewModel\CheckoutState\Proxy</argument>
        </arguments>
    </type>
</config>
